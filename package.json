{
  "name": "@ggate/sdk",
  "version": "0.3.0",
  "description": "Godel's Gate SDK for monitoring Node.js AI agent frameworks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/adapters", "dist/core", "dist/index.js", "dist/index.d.ts", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": ["ai", "agents", "security", "llm", "monitoring"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godellabs-ai/ggate-node.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
