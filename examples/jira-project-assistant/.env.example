# ---- Godel's Gate (required) ----------------------------------------------
# The SDK scans via the Console's /api/v1/scan endpoint using an IAM API key
# (Console UI -> Admin -> API keys). That is its only destination; the Console
# runs the full pipeline for each scan and records the event. Both values are
# required — without them every scan fails open.
#   dev (make console-dev):   https://localhost
#   prod (docker compose up): https://godels-gate.example.com
GGATE_CONSOLE_URL=https://localhost
GGATE_API_KEY=godel_...
# The team accountable for this deployed agent. Shown in the Console's Owner column, where a
# deployed agent has no person at a keyboard. The agent's own name ("JIRA Project Assistant")
# is declared in lib/ggate.ts — it is part of the application, not a deployment setting.
GGATE_TEAM=Project Management
# Deep attachment extraction/OCR can take longer than a text-only scan.
GGATE_TIMEOUT_MS=45000
# Dev only: accept a self-signed Console TLS cert (e.g. https://localhost).
# GGATE_CONSOLE_INSECURE=true

# ---- Model -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5

# ---- Jira (real site) ------------------------------------------------------
# The MCP server (sooperset/mcp-atlassian via uvx) and the attachment fetcher
# share these credentials. Create the token at id.atlassian.com.
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=...
# JIRA_READ_ONLY=true

# ---- Jira (no site? use the bundled mock) ----------------------------------
# JIRA_MCP_COMMAND=node
# JIRA_MCP_ARGS=["mock/jira-mock-server.mjs"]
