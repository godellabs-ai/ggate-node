{
  "name": "jira-project-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example LangGraph agent guarded by the Godel's Gate SDK: a Jira assistant whose prompts, MCP tool traffic, and attachments are all scanned before reaching the user.",
  "scripts": {
    "build:sdk": "npm --prefix ../.. install --ignore-scripts --no-audit --no-fund && npm --prefix ../.. run build",
    "predev": "npm run build:sdk",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build:sdk",
    "build": "next build",
    "start": "next start -p 3010",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "dependencies": {
    "@ggate/sdk": "file:../..",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/mcp-adapters": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "es5-ext@0.10.64": true,
    "fsevents@1.2.13": true
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
