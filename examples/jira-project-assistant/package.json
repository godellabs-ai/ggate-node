{
  "name": "jira-project-assistant",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Example LangGraph agent guarded by the G\u00f6del Gate SDK: a Jira assistant whose prompts, MCP tool traffic, and attachments are all scanned before reaching the user.",
  "scripts": {
    "build:sdk": "npm --prefix ../.. install --ignore-scripts --no-audit --no-fund && npm --prefix ../.. run build",
    "predev": "npm run build:sdk",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build:sdk",
    "build": "next build",
    "start": "next start -p 3010",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "dependencies": {
    "@ggate/sdk": "file:../..",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "es5-ext@0.10.64": true,
    "fsevents@1.2.13": true,
    "file:../../../..": true
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}
